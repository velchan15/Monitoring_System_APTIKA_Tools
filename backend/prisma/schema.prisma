datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Roles
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  users       User[]

  @@map("roles")
}

// 2. Departments / OPD
model Department {
  id           Int           @id @default(autoincrement())
  code         String        @unique @db.VarChar(50)
  name         String        @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at")
  users        User[]
  applications Application[]

  @@map("departments")
}

// 3. Users
model User {
  id           Int         @id @default(autoincrement())
  roleId       Int         @map("role_id")
  departmentId Int?        @map("department_id")
  name         String      @db.VarChar(100)
  email        String      @unique @db.VarChar(100)
  password     String      @db.VarChar(255)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  role       Role        @relation(fields: [roleId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  auditLogs  AuditLog[]

  @@map("users")
}

// 4. Monitoring Nodes
model MonitoringNode {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(100)
  location       String          @db.VarChar(100)
  ipAddress      String?         @map("ip_address") @db.VarChar(45)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  monitoringLogs MonitoringLog[]

  @@map("monitoring_nodes")
}

// 5. Applications
model Application {
  id                   Int                   @id @default(autoincrement())
  departmentId         Int                   @map("department_id")
  name                 String                @db.VarChar(150)
  url                  String                @db.VarChar(500)
  monitoringType       String                @default("HTTP") @map("monitoring_type") @db.VarChar(20)
  expectedKeyword      String?               @map("expected_keyword") @db.VarChar(100)
  intervalSeconds      Int                   @default(300) @map("interval_seconds")
  priority             String                @default("MEDIUM") @db.VarChar(20)
  showOnStatusPage     Boolean               @default(true) @map("show_on_status_page")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  department          Department            @relation(fields: [departmentId], references: [id])
  monitoringLogs      MonitoringLog[]
  incidents           Incident[]
  maintenanceSchedules MaintenanceSchedule[]
  uptimeSummaries     UptimeDailySummary[]

  @@map("applications")
}

// 6. Monitoring Logs
model MonitoringLog {
  id               BigInt         @id @default(autoincrement())
  applicationId    Int            @map("application_id")
  monitoringNodeId Int            @map("monitoring_node_id")
  statusCode       Int?           @map("status_code")
  responseTimeMs   Int?           @map("response_time_ms")
  isUp             Boolean        @map("is_up")
  errorMessage     String?        @map("error_message") @db.Text
  checkedAt        DateTime       @default(now()) @map("checked_at")

  application    Application    @relation(fields: [applicationId], references: [id])
  monitoringNode MonitoringNode @relation(fields: [monitoringNodeId], references: [id])
  screenshots    Screenshot[]

  @@map("monitoring_logs")
}

// 7. Screenshots
model Screenshot {
  id              BigInt        @id @default(autoincrement())
  monitoringLogId BigInt        @map("monitoring_log_id")
  filePath        String        @map("file_path") @db.VarChar(500)
  createdAt       DateTime      @default(now()) @map("created_at")

  monitoringLog MonitoringLog @relation(fields: [monitoringLogId], references: [id], onDelete: Cascade)

  @@map("screenshots")
}

// 8. Incidents
model Incident {
  id            BigInt         @id @default(autoincrement())
  applicationId Int            @map("application_id")
  startedAt     DateTime       @default(now()) @map("started_at")
  resolvedAt    DateTime?      @map("resolved_at")
  cause         String?        @db.Text
  isSuppressed  Boolean        @default(false) @map("is_suppressed")
  createdAt     DateTime       @default(now()) @map("created_at")

  application   Application    @relation(fields: [applicationId], references: [id])
  notifications Notification[]

  @@map("incidents")
}

// 9. Notifications
model Notification {
  id          BigInt   @id @default(autoincrement())
  incidentId  BigInt   @map("incident_id")
  channel     String   @db.VarChar(20)
  recipient   String   @db.VarChar(150)
  message     String   @db.Text
  status      String   @default("PENDING") @db.VarChar(20)
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime @default(now()) @map("created_at")

  incident    Incident @relation(fields: [incidentId], references: [id])

  @@map("notifications")
}

// 10. Maintenance Schedule
model MaintenanceSchedule {
  id            Int         @id @default(autoincrement())
  applicationId Int         @map("application_id")
  title         String      @db.VarChar(150)
  description   String?     @db.Text
  startTime     DateTime    @map("start_time")
  endTime       DateTime    @map("end_time")
  createdAt     DateTime    @default(now()) @map("created_at")

  application   Application @relation(fields: [applicationId], references: [id])

  @@map("maintenance_schedules")
}

// 11. Uptime Daily Summary
model UptimeDailySummary {
  id               BigInt      @id @default(autoincrement())
  applicationId    Int         @map("application_id")
  date             DateTime    @db.Date
  totalChecks      Int         @default(0) @map("total_checks")
  successfulChecks Int         @default(0) @map("successful_checks")
  uptimePercentage Decimal     @db.Decimal(5, 2) @map("uptime_percentage")
  avgResponseMs    Int?        @map("avg_response_ms")

  application      Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, date])
  @@map("uptime_daily_summaries")
}

// 12. Scheduler Heartbeat
model SchedulerHeartbeat {
  id            Int      @id @default(autoincrement())
  workerName    String   @unique @map("worker_name") @db.VarChar(50)
  lastHeartbeat DateTime @default(now()) @map("last_heartbeat")

  @@map("scheduler_heartbeats")
}

// 13. Audit Logs
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(100)
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// 14. Model IncidentUpdate
model IncidentUpdate {
  id          Int      @id @default(autoincrement())
  ticketId    Int
  message     String
  attachment  String?  // Kolom untuk menyimpan nama file/path screenshot
  createdAt   DateTime @default(now())
  
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
}