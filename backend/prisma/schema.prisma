// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === ENUMS (Standarisasi Nilai) ===
enum Role {
  SUPER_ADMIN
  OPD_ADMIN
  VIEWER
}

enum AppStatus {
  ONLINE
  WARNING
  OFFLINE
  MAINTENANCE
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

// === MODELS (Tabel Inti) ===

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         Role        @default(VIEWER)
  
  // Relasi ke tabel Department (Opsional, jika dia Admin OPD tertentu)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Department {
  id           String        @id @default(uuid())
  name         String
  code         String?       @unique // Singkatan/Kode OPD (misal: DISKOMINFO)
  
  applications Application[]
  users        User[]
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Application {
  id             String          @id @default(uuid())
  name           String
  url            String
  
  // Relasi ke tabel Department
  departmentId   String
  department     Department      @relation(fields: [departmentId], references: [id])
  
  currentStatus  AppStatus       @default(ONLINE)
  isMonitored    Boolean         @default(true)
  checkInterval  Int             @default(5) // Interval cek (dalam menit)
  
  logs           MonitoringLog[]
  incidents      Incident[]
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model MonitoringLog {
  id            String      @id @default(uuid())
  
  // Relasi ke tabel Application
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  status        AppStatus
  responseTime  Int?        // Waktu respon dalam milidetik (ms)
  statusCode    Int?        // HTTP status code (misal: 200, 404, 500)
  errorMessage  String?     // Detail error jika website offline
  checkedAt     DateTime    @default(now())

  // Indexing agar query untuk grafik di Looker Studio/Dashboard lebih cepat
  @@index([applicationId])
  @@index([checkedAt])
}

model Incident {
  id            String         @id @default(uuid())
  
  // Relasi ke tabel Application
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  title         String
  description   String?
  status        IncidentStatus @default(OPEN)
  
  startedAt     DateTime       @default(now())
  resolvedAt    DateTime?
  updatedAt     DateTime       @updatedAt
}